#ifndef SECRETS_H
#define SECRETS_H

// ── WiFi Credentials ──────────────────────────────────────
const char* ssid     = "YOUR_WIFI_SSID";
const char* password = "YOUR_WIFI_PASSWORD";

// ── AWS IoT Core Configuration ────────────────────────────
// Replace with your actual AWS IoT Core endpoint:
const char* AWS_IOT_ENDPOINT = "YOUR_AWS_ENDPOINT.iot.ap-south-1.amazonaws.com";
const char* AWS_IOT_TOPIC    = "health/esp32-user-1/raw";

// Root CA 1 Certificate
const char* AWS_CERT_CA = R"EOF(
-----BEGIN CERTIFICATE-----
... [Insert Amazon Root CA 1 Certificate Here] ...
-----END CERTIFICATE-----
)EOF";

// Device Certificate
const char* AWS_CERT_CRT = R"EOF(
-----BEGIN CERTIFICATE-----
... [Insert Device Certificate Here] ...
-----END CERTIFICATE-----
)EOF";

// Device Private Key
const char* AWS_CERT_PRIVATE = R"EOF(
-----BEGIN RSA PRIVATE KEY-----
... [Insert Device Private Key Here] ...
-----END RSA PRIVATE KEY-----
)EOF";

#endif
